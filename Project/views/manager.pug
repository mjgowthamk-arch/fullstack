doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title Manager Dashboard
        link(rel="stylesheet" href="/toast.css")
        script(src="/toast.js")

        // 1. ADDED CDNs (Content Delivery Network): jQuery, DataTables, Select2, and jQuery UI (Datepicker)
        script(src="https://code.jquery.com/jquery-3.7.1.min.js")
        link(rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css")
        script(src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js")

        link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css")
        script(src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js")

        link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/themes/base/jquery-ui.min.css")
        script(src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/jquery-ui.min.js")

        style.
            * { box-sizing: border-box; font-family: Arial, sans-serif; }
            body { background-color: lightgray; display: flex; justify-content: center; align-items: center; overflow: hidden; height: 100vh; margin: 0; }
            .wrapper { display: flex; width: 100%; height: 100vh; }
            .manager-form-panel { flex: 1; border-right: 2px solid #e2e8f0; background-color: white; padding: 30px; display: flex; flex-direction: column; justify-content: space-between; }
            .manager-form-panel h1 { color: darkblue; margin: 0 0 5px 0; font-size: 30px; }
            .manager-form-panel h2 { color: darkblue; margin: 0 0 10px 0; font-size: 20px; }
            .manager-form-panel h3 { color: darkgreen; margin: 0 0 10px 0; font-size: 18px; }
            .manager-form-panel label { display: block; margin-top: 12px; font-weight: bold; font-size: 15px; }
            .manager-form-panel input, .manager-form-panel select, .manager-form-panel textarea { width: 100%; padding: 10px; margin: 6px 0; border-radius: 5px; border: 2px solid #e2e8f0; }
            .form-container { padding: 30px; background-color: #f8fafc; border: 2px solid #e2e8f0; border-radius: 8px; }
            .add-btn { width: 100%; padding: 10px; margin-top: 15px; background-color: blue; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 15px; font-weight: bold; }
            .add-btn:hover { background-color: #0056b3; transition: all 0.5s ease; }
            .logout-btn { align-self: flex-start; background: red; color: white; font-weight: bold; margin-top: 20px; border: none; padding:5px 8px; border-radius:3px; cursor:pointer; }
            .logout-btn:hover { background: #813030; transition: all 0.5s ease; }
            .manager-table-panel { flex: 2; padding: 30px; background-color: white; display: flex; flex-direction: column; }
            .manager-table-panel h1 { color: darkblue; margin: 0 0 15px 0; }
            .table-container { overflow-y: auto; flex: 1; }
            table { width: 100%; border-collapse: collapse; }
            th, td { padding: 10px 12px; text-align: left; border: 2px solid black; font-size: 15px; }
            th { background-color: gainsboro; }
            /* Adjust Select2 styling to match inputs */
            .select2-container .select2-selection--single { height: 40px; padding: 5px; border: 2px solid #e2e8f0; }
            .profile-image { cursor: pointer; border-radius: 50%; width: 70px; height: 70px; object-fit: cover; border: 3px solid #1e3a8a; background-color: #cbd5e1; }

    body
        .wrapper
            .manager-form-panel 
                .form-container
                    h1 Manager Dashboard
                    
                    //- Profile Picture Upload Container with Camera Badge
                    div(style="position: relative; display: inline-block; cursor: pointer; margin-bottom: 10px;" onclick="$('#fileInput').click()" title="Click to upload profile picture")
                        img#profilePic.profile-image(src="" alt="Profile Picture")
                        div(style="position: absolute; bottom: 0; right: 0; background: #1e3a8a; color: white; border-radius: 50%; width: 22px; height: 22px; display: flex; align-items: center; justify-content: center; font-size: 11px;") 📷
                    
                    input#fileInput(type="file" accept="image/*" style="display: none;" onchange="uploadProfilePic(this)")

                    h2#welcomeText Welcome, Manager!
                    div(style="background-color: white; border: 2px solid #e2e8f0; border-radius: 6px; padding: 10px; margin-bottom: 10px;")
                        span(style="font-size: 14px; font-weight: bold; color: #49586c;") Assigned Interns:
                        span#assignedCount(style="font-size: 14px; font-weight: bold; color: #1e3a8a; margin-left: 6px;") 0

                    h3 Assign Task
                    form#taskForm
                        label(for="selectIntern") Select Intern:
                        select#selectIntern(required style="width: 100%;")

                        label(for="taskTitle") Task Assigned:
                        textarea#taskTitle(placeholder="e.g., Intern Management System" style="height: 100px;" required)

                        // 2. ADDED: Datepicker input field for Target Deadline
                        label(for="taskDeadline") Target Deadline:
                        input#taskDeadline(type="text" placeholder="Select Date" required autocomplete="off")

                        button.add-btn(type="submit") Assign Task

                button.logout-btn(type="button" onclick="logout();") Logout

            .manager-table-panel
                h1 My Assigned Interns

                .table-container
                    // 3. ADDED: DataTables display class
                    table#intern-table.display(style="width:100%")

        script.
            $(document).ready(function() {
                const currentUser = localStorage.getItem('currentUser');
                if (!currentUser) {
                    alert('Access Denied! Please log in first.');
                    window.location.href = '/';
                }
                const user = JSON.parse(currentUser);
                if (user.role !== 'manager') {
                    alert('Access Denied! Managers only.');
                    window.location.href = '/';
                }

                // Render Profile Picture or Default SVG placeholder immediately
                if (user.profile_pic) {
                    $('#profilePic').attr('src', user.profile_pic);
                } else {
                    $('#profilePic').attr('src', 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="70" height="70" viewBox="0 0 24 24" fill="none" stroke="%2364748b" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>');
                }

                $('#welcomeText').text(`Welcome, ${user.exactRole}!`);

                // 4. INITIALIZE PLUGINS
                $('#taskDeadline').datepicker({ dateFormat: 'yy-mm-dd', minDate: 0 }); // Prevents selecting past dates
                $('#selectIntern').select2({ placeholder: "--- Search Intern ---", allowClear: true });

                loadData();

                $('#taskForm').on('submit', function(e) {
                    e.preventDefault();
                    assignTask();
                });
            });

            async function logout() {
                try {
                    await $.post('/logout'); 
                } catch (err) {
                    console.log("Error logging out");
                }
                localStorage.removeItem('currentUser');
                window.location.href = '/';
            }

            async function loadData() {
                const user = JSON.parse(localStorage.getItem('currentUser'));
                try {
                    const interns = await $.ajax({ url: '/api/interns', method: 'GET' });
                    const assignedInterns = interns.filter(i => i.manager.trim().toLowerCase() === user.exactRole.trim().toLowerCase());

                    $('#assignedCount').text(assignedInterns.length);

                    // Populate Select2 Dropdown
                    const $select = $('#selectIntern');
                    $select.empty().append("<option value=''></option>");
                    assignedInterns.forEach(intern => {
                        $select.append(`<option value="${intern.email}">${intern.name} (${intern.role})</option>`);
                    });

                    // Initialize DataTable
                    const $table = $('#intern-table');
                    if ($.fn.DataTable.isDataTable('#intern-table')) {
                        $table.DataTable().clear().destroy();
                    }
                    $table.empty();
                    $table.append(`
                        <thead>
                            <tr><th>Intern</th><th>Task Assigned</th><th>Status</th><th>Deadline</th><th>Score</th><th>Feedback</th><th>Action</th></tr>
                        </thead>
                        <tbody></tbody>
                    `);

                    let hasTask = false;
                    assignedInterns.forEach(intern => {
                        intern.tasks.forEach(task => {
                            hasTask = true;

                            let borderColor = task.status === 'Pending' ? '#ff4d4d' : (task.status === 'In Progress' ? '#e6ca18' : '#28a745');

                            $('#intern-table tbody').append(`
                                <tr>
                                    <td>${intern.name}</td>
                                    <td>
                                        <textarea id="task_title_${task.id}" style="width:100%;height:80px;padding:5px;">${task.title}</textarea>
                                        <small style="color:grey;display:block;">Assigned: ${task.assignedDate}</small>
                                    </td>
                                    <td>
                                        <select onchange="updateStatus(${task.id}, this.value);" style="padding: 4px; border-left: 10px solid ${borderColor};">
                                            <option value="Pending" ${task.status === 'Pending' ? 'selected' : ''}>Pending</option>
                                            <option value="In Progress" ${task.status === 'In Progress' ? 'selected' : ''}>In Progress</option>
                                            <option value="Completed" ${task.status === 'Completed' ? 'selected' : ''}>Completed</option>
                                        </select>
                                    </td>
                                    <td>

                                        <span style="font-weight: bold; color: ${task.deadline === 'No Deadline' ? '#999' : '#1e3a8a'};">
                                        ${task.deadline} 
                                        </span>
                                    </td>
                                    <td>
                                        <input type="number" id="score_${task.id}" min="0" max="100" style="width:50px;padding:3px;text-align:center;" placeholder="0" value="${task.score !== '-' ? task.score : ''}">
                                        <span style="font-size: 12px; font-weight: bold;">/ 100</span>
                                    </td>
                                    <td><textarea id="fb_${task.id}" style="width:100%;height:80px;padding:5px;">${task.feedback}</textarea></td>
                                    <td>
                                        <button style="background:green;color:white;border:none;padding:5px 8px;cursor:pointer;" onclick="saveScoreAndFeedback(${task.id})">Save</button>
                                        <button type="button" style="background:red;color:white;border:none;padding:5px 8px;cursor:pointer;margin-top:4px;" onclick="deleteTask(${task.id})">Delete</button>
                                    </td>
                                </tr>
                            `);
                        });
                    });

                    $table.DataTable({ 
                        pageLength: 5, 
                        lengthMenu: [5, 10, 20],
                        language: {
                            emptyTable: "No tasks assigned yet." // DataTables handles the colspan safely here
                        }
                    });

                } catch (err) {
                    if (err.status === 401 || err.status === 403) logout();
                }
            }

            async function assignTask() {
                const internEmail = $('#selectIntern').val();
                const title = $('#taskTitle').val().trim();
                const deadline = $('#taskDeadline').val(); // Capture deadline data from Datepicker

                if (!internEmail || !title || !deadline) return;

                try {
                    await $.ajax({
                        url: '/api/tasks',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ internEmail, title, deadline })
                    });
                    showToast("Task assigned successfully!", "success");

                    $('#taskForm')[0].reset();
                    $('#selectIntern').val(null).trigger('change'); // Reset Select2
                    loadData();
                } catch (err) {
                    showToast("Error assigning task", "success");
                    console.error("Backend Error:", err.responseJSON);
                }
            }

            // Rest of the functions remain functionally identical but utilize jQuery logic where needed
            async function saveScoreAndFeedback(taskId) {
                const score = $(`#score_${taskId}`).val().trim();
                const feedback = $(`#fb_${taskId}`).val().trim();
                const title = $(`#task_title_${taskId}`).val().trim();

                if (score !== '' && (isNaN(Number(score)) || Number(score) < 0 || Number(score) > 100)) {
                    return showToast("Please enter a valid score (0-100).", "error");
                }
                await $.ajax({
                    url: `/api/tasks/${taskId}/score`,
                    method: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ title, score, feedback })
                });
                showToast("Score saved successfully!");
                loadData();
            }

            async function updateStatus(taskId, newStatus) {
                await $.ajax({
                    url: `/api/tasks/${taskId}/status`,
                    method: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify({ status: newStatus })
                });
                showToast(`Status updated to ${newStatus}.`);
                loadData();
            }

            async function deleteTask(taskId) {
                if (!confirm('Are you sure you want to delete this task?')) return;
                await $.ajax({ url: `/api/tasks/${taskId}`, method: 'DELETE' });
                showToast("Task deleted successfully!", "success"); 
                loadData();
            }

            async function uploadProfilePic(input) {
                if (input.files && input.files[0]) {
                    const reader = new FileReader();
                    reader.onload = async function(e) {
                        const base64Image = e.target.result;
                        try {
                            await $.ajax({
                                url: '/api/users/profile-pic',
                                method: 'PUT',
                                contentType: 'application/json',
                                data: JSON.stringify({ profile_pic: base64Image })
                            });
                            let currentUser = JSON.parse(localStorage.getItem('currentUser'));
                            currentUser.profile_pic = base64Image;
                            localStorage.setItem('currentUser', JSON.stringify(currentUser));
                            $('#profilePic').attr('src', base64Image);
                            showToast("Profile picture updated successfully!", "success");
                        } catch (err) {
                            showToast("Failed to upload image.", "error");
                        }
                    };
                    reader.readAsDataURL(input.files[0]);
                }
            }