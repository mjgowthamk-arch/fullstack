doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Admin Dashboard
    link(rel="stylesheet" href="/toast.css")
    script(src="/toast.js")
    
    // 1. ADDED CDNs (Content Delivery Network): jQuery, DataTables, and Chart.js
    script(src="https://code.jquery.com/jquery-3.7.1.min.js")
    link(rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css")
    script(src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js")
    script(src="/chart.js")
    
    style.
      * { box-sizing: border-box; }
      body { font-family: Arial, sans-serif; background-color: lightgray; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; overflow: hidden; }
      .wrapper { display: flex; width: 100%; height: 100vh; }
      .admin-dashboard { flex: 1; border-right: 2px solid #e2e8f0; background-color: white; padding: 30px; display: flex; flex-direction: column; justify-content: space-between; }
      .admin-dashboard h1 { color: darkblue; margin: 0 0 5px 0; font-size: 30px; }
      .admin-dashboard h2 { color: darkblue; margin: 0 0 20px 0; font-size: 20px; }
      .admin-dashboard h3 { color: darkgreen; margin: 0 0 15px 0; font-size: 18px; }
      .admin-dashboard label { display: block; margin-top: 10px; font-weight: bold; font-size: 15px; }
      .admin-dashboard input, .admin-dashboard select { width: 100%; padding: 10px; margin-top: 5px; margin-bottom: 12px; border-radius: 5px; border: 1px solid #ccc; }
      .form-container { height: 100%; padding: 30px; background-color: #f8fafc; border: 2px solid #e2e8f0; border-radius: 8px; }
      .add-btn { width: 100%; padding: 10px; margin-top: 15px; background-color: blue; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 15px; font-weight: bold; }
      .add-btn:hover { background-color: #0056b3; transition: all 0.5s ease; }
      .export-btn { background-color: #078960; color: white; border: none; padding: 8px 16px; border-radius: 5px; cursor: pointer; font-size: 14px; }
      .export-btn:hover { background-color: #047857; }
      .logout-btn { align-self: flex-start; background: red; color: white; font-weight: bold; margin-top: 20px; border: none; padding:5px 8px; border-radius:3px; cursor:pointer; }
      .logout-btn:hover { background: #c74040; transition: all 0.5s ease; }
      .intern-list { flex: 2; padding: 30px; background-color: white; display: flex; flex-direction: column; }
      .intern-list h1 { color: darkblue; margin: 0; }
      .table-container { overflow-y:auto; flex: 1; }
      table { width: 100%; border-collapse: collapse; }
      th, td { padding: 10px 12px; text-align: left; border: 2px solid black; font-size: 15px; }
      th { background-color: gainsboro; }
      .delete-btn { background-color: red; color: white; border: none; padding: 5px 10px; border-radius: 3px; cursor: pointer; font-size: 12px; }
      .delete-btn:hover { background-color: #b91c1c; transition: all 0.5s ease; }
      .ov-box { display: flex; margin-bottom: 20px; gap: 15px; }
      .interns-info { flex: 1; background-color: #f8fafc; border: 2px solid #e2e8f0; border-radius: 8px; padding: 12px 18px; display: flex; flex-direction: column; gap: 6px; }
      .box { font-size: 13px; font-weight: bold; color: #6a7990; }
      .box-value { font-size: 24px; font-weight: bold; color: #1e3a8a; }

  body
    .wrapper
      .admin-dashboard
        .form-container
          h1 Admin Dashboard
          h2 Welcome, HR Admin!
          h3 Add New Intern
          
          // 2. UPDATED: Form now uses standard id, submission handled by jQuery below
          form#addIntern
            label(for="internName") Full Name:
            input#internName(type="text" name="internName" required)
            
            label(for="internEmail") Email:
            input#internEmail(type="email" name="internEmail" required)
            
            label(for="internRole") Role:
            select#internRole(name="internRole" required)
              option(value="") Select Role
              option(value="Full Stack - Intern") Full Stack - Intern
              option(value="Android - Intern") Android - Intern
              
            label(for="manager") Assign to Manager:
            select#manager(name="manager" required)
              option(value="") Select Manager
              option(value="Manager 1") Manager 1
              option(value="Manager 2") Manager 2
              
            button.add-btn(type="submit") Add Intern
            
        button.logout-btn(type="button" onclick="logout();") Logout
        
      .intern-list
        div(style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;")
          h1 Intern List
          button.export-btn(type="button" onclick="exportToCSV();") Export CSV
          
        .ov-box
          .interns-info
            span.box Total Interns:
            span#totalInternsVal.box-value 0
          .interns-info
            span.box Total Task Assigned:
            span#totalTasksVal.box-value 0
          .interns-info
            span.box Average Performance:
            span#overallAvgVal.box-value -
            
        // 3. ADDED: Chart.js Canvas Container (Replaced the manual search bar)
        div(style="background: white; padding: 15px; margin-bottom: 20px; border: 2px solid #e2e8f0; border-radius: 8px;")
          h3(style="margin-top: 0; color: #49586c; font-size: 16px;") Task Status Overview
          div(style="height: 200px; width: 100%; display: flex; justify-content: center;")
            canvas#statusChart
            
        .table-container
          // 4. UPDATED: Added DataTables "display" class to the table
          table#intern-table.display(style="width:100%")

    script.
      // 5. ADDED: Global variable to keep track of the Chart instance
      let myChart = null; 

      // 6. UPDATED: Replaced window.onload with jQuery $(document).ready()
      $(document).ready(function() {
          const currentUser = localStorage.getItem('currentUser');
          if (!currentUser) {
              alert('Login as admin.');
              window.location.href = '/'; 
          }
          const userObj = JSON.parse(currentUser);
          if (userObj.role !== 'admin') {
              alert('Access Denied! Admins only.');
              window.location.href = '/';
          }

          // Initial load
          showIntern();

          // 7. UPDATED: Form submission handled via jQuery instead of inline HTML onsubmit
          $('#addIntern').on('submit', function(e) {
              e.preventDefault();
              addIntern();
          });
      });

      async function logout() {
          try {
              // 8. UPDATED: Replaced native fetch with jQuery $.post
              await $.post('/logout'); 
          } catch (err) {
              console.log("Error logging out from server");
          }
          localStorage.removeItem('currentUser');
          window.location.href = '/';
      }

      async function fetchInterns() {
          try {
              // 9. UPDATED: Replaced native fetch with jQuery $.ajax
              return await $.ajax({
                  url: '/api/interns',
                  method: 'GET'
              });
          } catch (err) {
              if (err.status === 401 || err.status === 403) logout();
          }
      }

      async function addIntern() {
          // 10. UPDATED: jQuery selector for input values
          const name = $('#internName').val().trim();
          const email = $('#internEmail').val().trim();
          const role = $('#internRole').val().trim();
          const manager = $('#manager').val().trim();

          try {
              // 11. UPDATED: jQuery AJAX POST
              await $.ajax({
                  url: '/api/interns',
                  method: 'POST',
                  contentType: 'application/json',
                  data: JSON.stringify({ name, email, role, manager })
              });
              showToast(`Intern ${name} added successfully!`, 'success');
              $('#addIntern')[0].reset();
              showIntern();
          } catch (err) {
              showToast("Error adding intern or email exists.", "error");
          }
      }

      async function showIntern() {
          const interns = await fetchInterns();
          if (!interns) return; 

          const $table = $('#intern-table');
          
          // 12. ADDED: DataTables requires us to destroy the existing table before rewriting HTML
          if ($.fn.DataTable.isDataTable('#intern-table')) {
              $table.DataTable().clear().destroy();
          }

          $table.empty(); 
          
          // 13. UPDATED: DataTables requires proper <thead> and <tbody> tags
          $table.append(`
            <thead>
              <tr><th>Name</th><th>Email</th><th>Role</th><th>Manager</th><th>Avg Points</th><th>Action</th></tr>
            </thead>
            <tbody></tbody>
          `);

          if (interns.length === 0) {
              $table.find('tbody').append('<tr><td colspan="6" style="text-align:center; padding: 20px;">No interns yet.</td></tr>');
              $('#totalInternsVal').text('0');
              $('#totalTasksVal').text('0');
              $('#overallAvgVal').text('-');
              updateChart({ 'Pending': 0, 'In Progress': 0, 'Completed': 0 }); // Empty chart
              return;
          }

          let totalTaskCount = 0;
          let allGradedScores = [];
          
          // Data tracking for Chart.js
          let statusCounts = { 'Pending': 0, 'In Progress': 0, 'Completed': 0 };

          interns.forEach(intern => {
              const returnVal = calculateTaskAvg(intern);
              let color = returnVal !== '-' ? (parseFloat(returnVal) >= 80 ? 'green' : (parseFloat(returnVal) >= 50 ? 'orange' : 'red')) : '';

              // Append rows to the new <tbody>
              $('#intern-table tbody').append(`
                  <tr>
                      <td>${intern.name}</td>
                      <td>${intern.email}</td>
                      <td>${intern.role}</td>
                      <td>${intern.manager}</td>
                      <td style="color: ${color}; font-weight: bold;">${returnVal}</td>
                      <td><button class="delete-btn" onclick="deleteIntern('${intern.email}')">Delete</button></td>
                  </tr>
              `);

              intern.tasks.forEach(task => {
                  totalTaskCount++;
                  if (typeof task.score === "number" || (!isNaN(task.score) && task.score !== '-')) {
                      allGradedScores.push(Number(task.score));
                  }
                  // Increment status counters for the chart
                  if (statusCounts[task.status] !== undefined) statusCounts[task.status]++;
              });
          });

          // 14. ADDED: Initialize the DataTable with pagination and search
          $table.DataTable({
              pageLength: 5,
              lengthMenu: [5, 10, 20],
              language: { search: "Search Interns:" }
          });

          // Update DOM stats
          $('#totalInternsVal').text(interns.length);
          $('#totalTasksVal').text(totalTaskCount);
          $('#overallAvgVal').text(allGradedScores.length >= 1 ? `${(allGradedScores.reduce((sum, i) => sum + i, 0) / allGradedScores.length).toFixed(1)} / 100` : '-');

          // 15. ADDED: Render the Chart.js visual
          updateChart(statusCounts);
      }

      // 16. ADDED: Chart.js rendering function
      function updateChart(counts) {
          const ctx = document.getElementById('statusChart').getContext('2d');
          
          // If chart exists, destroy it before rendering a new one (prevents overlap glitch)
          if (myChart) myChart.destroy();

          myChart = new Chart(ctx, {
              type: 'doughnut',
              data: {
                  labels: ['Pending', 'In Progress', 'Completed'],
                  datasets: [{
                      data: [counts['Pending'], counts['In Progress'], counts['Completed']],
                      backgroundColor: ['#ff4d4d', '#e6ca18', '#28a745'] // Red, Yellow, Green
                  }]
              },
              options: {
                  responsive: true,
                  maintainAspectRatio: false,
                  plugins: { legend: { position: 'right' } }
              }
          });
      }

      function calculateTaskAvg(intern) {
          const graded = intern.tasks.filter(t => t.score !== '-' && !isNaN(t.score)).map(t => Number(t.score));
          if (graded.length === 0) return '-';
          const sum = graded.reduce((sum, i) => sum + i, 0);
          return `${(sum / graded.length).toFixed(1)} / 100`;
      }

      async function deleteIntern(email) {
          if (!confirm('Are you sure you want to delete this intern?')) return;
          try {
              // 17. UPDATED: jQuery AJAX DELETE
              await $.ajax({
                  url: `/api/interns/${email}`,
                  method: 'DELETE'
              });
              showToast('Intern deleted successfully!', 'success');
              showIntern();
          } catch(err) {
              showToast('Internal Server Error', 'error');
          }
      }
      
      function exportToCSV() {
        window.location.href = '/api/export/interns';
        }